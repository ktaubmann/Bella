<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.kiliantaubmann.bella</groupId>
    <artifactId>bella.parent</artifactId>
    <version>0.4.4-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>de.kiliantaubmann.bella.updatesite</artifactId>
  <packaging>eclipse-repository</packaging>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <repositoryName>Bella – AI assistant for ABAP</repositoryName>
          <includeAllDependencies>false</includeAllDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      PGP-signs every bundle and feature in the update site, so Eclipse shows
      the key in its trust dialog instead of "unsigned content". Only the
      release build activates it (-Psign) and needs these environment
      variables: BELLA_GPG_KEY_FILE (path to the ASCII-armored secret key),
      BELLA_GPG_KEYNAME (key fingerprint) and MAVEN_GPG_PASSPHRASE.
    -->
    <profile>
      <id>sign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-gpg-plugin</artifactId>
            <version>${tycho.version}</version>
            <executions>
              <execution>
                <id>pgpsigner</id>
                <goals>
                  <goal>sign-p2-artifacts</goal>
                </goals>
                <configuration>
                  <signer>bc</signer>
                  <secretKeys>${env.BELLA_GPG_KEY_FILE}</secretKeys>
                  <keyname>${env.BELLA_GPG_KEYNAME}</keyname>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
