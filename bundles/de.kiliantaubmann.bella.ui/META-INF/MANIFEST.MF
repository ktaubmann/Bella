 org.eclipse.compare,
 org.eclipse.equinox.security,
 org.eclipse.core.expressions,
 org.eclipse.core.filesystem,
 org.eclipse.ui.ide,
 de.kiliantaubmann.bella.core
Import-Package: com.google.gson;version="2.8.0",
 org.osgi.util.tracker
